# Copy to .env beside docker-compose.yml, then: docker compose up -d
#
# Generate secrets (use different values for each):
#   JWT_SECRET:        openssl rand -hex 32     — session / JWT cookie signing
#   AUTH_SECRETS_KEY:  openssl rand -base64 32  — encrypt stored IdP client secrets (OIDC)

POSTGRES_PASSWORD=change-me-in-production
JWT_SECRET=change-me-in-production

# Optional: set false for API-only container (no SPA; map host port to 3001)
# ENABLE_INTERNAL_NGINX=true

# Authentication
# Local login is enabled by default.
# LOCAL_LOGIN_ENABLED=false disables password authentication.
LOCAL_LOGIN_ENABLED=true

# OpenID Connect (optional — see docs: options/federated-identity.md)
#
# Leave OIDC_ENABLED unset for Admin-managed Identity Providers (default).
#
# Set OIDC_ENABLED=true to manage a single OIDC provider from environment:
# OIDC_PROVIDER_NAME="OpenID Connect"
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
#
# Set OIDC_ENABLED=false to force OIDC off.
#
# AUTH_SECRETS_KEY=              # openssl rand -base64 32 — required in production for OIDC (not the same as JWT_SECRET)
